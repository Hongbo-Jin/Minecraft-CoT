# Template for W&B credentials. Copy to `.env.wandb` and fill in your values.
# `.env.wandb` is git-ignored (this repo is PUBLIC) -- never commit a real key.
# For LOCAL runs, train_stage*.sh auto-sources this file via common.sh.
# For REMOTE koala runs, instead export WANDB_API_KEY/HOST in the submit command.
#
# WANDB_API_KEY=your_api_key_here
# WANDB_PROJECT=minecraft-sft
# WANDB_ENTITY=your_team       # optional
# WANDB_RUN_NAME=my-run        # optional; each stage script also sets a default
# WANDB_HOST=https://api.wandb.ai   # optional; for a self-hosted instance set this
